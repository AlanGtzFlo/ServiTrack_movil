<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#F0F0F0" /> <!-- Fondo blanco (puedes cambiarlo) -->

    <stroke
        android:width="2dp"
        android:color="#E7E7E7" /> <!-- Color del borde -->

    <corners android:radius="12dp" /> <!-- Bordes redondeados -->

    <padding
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp" />

    <text
        android:color="#000000" /> <!-- Color del texto (opcional) -->

</shape>