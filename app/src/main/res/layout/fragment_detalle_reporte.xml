<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Título -->
    <TextView
        android:id="@+id/txtTituloDetalle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Título del reporte"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#003F4E"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Estado -->
    <TextView
        android:id="@+id/txtEstadoDetalle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Estado: En proceso"
        android:textSize="18sp"
        android:textColor="#666"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/txtTituloDetalle"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Fecha -->
    <TextView
        android:id="@+id/txtFechaDetalle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fecha: 12 abr 2025"
        android:textSize="18sp"
        android:textColor="#666"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/txtEstadoDetalle"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Aquí podrías agregar más campos según el modelo de Reporte -->

</androidx.constraintlayout.widget.ConstraintLayout>
