<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:background="@android:color/white">

        <!-- Imagen del usuario -->
        <ImageView
            android:id="@+id/imgUsuario"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="32dp"
            android:contentDescription="Foto del usuario"
            android:scaleType="centerCrop"
            android:src="@drawable/icono_lock"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardFormContraseñas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@+id/imgUsuario"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#006D77"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTitulo1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cambio de contraseña"
                    android:textColor="#FFFFFF"
                    android:textSize="24dp"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:layout_marginTop="8dp"/>

                <!-- Contraseña actual -->
                <EditText
                    android:id="@+id/edtPasswordAnterior"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/rounded_edittext"
                    android:drawableStart="@drawable/icon_lock"
                    android:hint="Contraseña actual"
                    android:inputType="textPassword"
                    android:textColor="#000000" />

                <!-- Nueva contraseña -->
                <EditText
                    android:id="@+id/edtPasswordNueva"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/rounded_edittext"
                    android:drawableStart="@drawable/icon_lock"
                    android:hint="Nueva contraseña"
                    android:inputType="textPassword"
                    android:textColor="#000000" />

                <!-- Confirmar nueva contraseña -->
                <EditText
                    android:id="@+id/edtPasswordConfirmar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/rounded_edittext"
                    android:drawableStart="@drawable/ic_lockrepeat"
                    android:hint="Confirmar nueva contraseña"
                    android:inputType="textPassword"
                    android:textColor="#000000" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Botón guardar -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGuardarCambio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/rounded_button_orange"
            android:text="Guardar contraseña"
            android:textColor="@android:color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardFormContraseñas" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
